                  "clave": { "type": "string" },
                  "valor": { "type": "string" },
                  "descripcion": { "type": "string" },
                  "tipo": { "type": "string", "enum": ["texto", "numero", "booleano", "fecha", "json"] }
                }
              }
            }
          }
        },
        "responses": { "200": { "description": "OK" } }
