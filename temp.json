{
  "openapi": "3.0.3",
  "info": {
    "title": "Modulos API",
    "description": "API REST del sistema modular Dart/Flutter",
    "version": "1.0.0"
  },
  "servers": [
    { "url": "http://localhost:8080" }
  ],
  "tags": [
    { "name": "Clientes" },
    { "name": "Productos" },
    { "name": "Usuarios" },
    { "name": "Ventas" },
    { "name": "Citas" },
    { "name": "Inventario" },
    { "name": "Reportes" },
    { "name": "Notificaciones" },
    { "name": "Configuracion" }
  ],
  "paths": {
    "/api/clientes": {
      "get": {
        "tags": ["Clientes"],
        "summary": "Listar clientes",
        "operationId": "obtenerClientes",
        "responses": {
          "200": { "description": "Lista de clientes" }
        }
      },
      "post": {
        "tags": ["Clientes"],
        "summary": "Crear cliente",
        "operationId": "crearCliente",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["id", "nombre"],
                "properties": {
                  "id": { "type": "string" },
                  "nombre": { "type": "string" },
                  "email": { "type": "string" },
                  "telefono": { "type": "string" },
                  "rfc": { "type": "string" },
                  "direccion": { "type": "string" },
                  "notas": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": { "200": { "description": "Cliente creado" } }
      }
    },
    "/api/clientes/{id}": {
      "get": {
        "tags": ["Clientes"],
        "summary": "Obtener cliente",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "OK" } }
      },
      "put": {
        "tags": ["Clientes"],
        "summary": "Actualizar cliente",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "OK" } }
      },
      "delete": {
        "tags": ["Clientes"],
        "summary": "Eliminar cliente",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/api/productos": {
      "get": {
        "tags": ["Productos"],
        "summary": "Listar productos",
        "responses": { "200": { "description": "OK" } }
      },
      "post": {
        "tags": ["Productos"],
        "summary": "Crear producto",
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/api/usuarios": {
      "get": {
        "tags": ["Usuarios"],
