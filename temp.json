        "summary": "Registrar movimiento",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["id", "producto_id", "tipo", "cantidad"],
                "properties": {
                  "id": { "type": "string" },
                  "producto_id": { "type": "string" },
                  "tipo": { "type": "string", "enum": ["entrada", "salida", "ajuste"] },
